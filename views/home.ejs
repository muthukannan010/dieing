<!-- Interactive weave canvas logic + count up -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Canvas Weave Animation
    const canvas = document.getElementById('textileCanvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      
      function resizeCanvas() {
        // Set canvas physical sizing matching CSS layout
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
      }
      
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      
      let phase = 0;
      
      function draw() {
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);
        
        // Solid background matching page theme
        ctx.fillStyle = document.body.classList.contains('dark-mode') ? '#142316' : '#F5FFF5';
        ctx.fillRect(0, 0, w, h);
        
        const threadSpacing = 16;
        const numWarp = Math.ceil(w / threadSpacing);
        const numWeft = Math.ceil(h / threadSpacing);
        
        phase += 0.015;
        
        // Draw warp threads (Vertical threads)
        for (let i = 0; i < numWarp; i++) {
          const x = i * threadSpacing;
          const wave = Math.sin(phase + i * 0.4) * 4;
          
          // Emerald Green gradient
          const grad = ctx.createLinearGradient(x + wave, 0, x + wave + 6, 0);
          grad.addColorStop(0, '#047857');
          grad.addColorStop(0.5, '#10b981');
          grad.addColorStop(1, '#059669');
          
          ctx.fillStyle = grad;
          ctx.fillRect(x + wave, 0, 6, h);
        }
        
        // Draw weft threads (Horizontal threads)
        for (let j = 0; j < numWeft; j++) {
          const y = j * threadSpacing;
          const wave = Math.cos(phase + j * 0.4) * 4;
          
          // Teal/Cyan gradient
          const grad = ctx.createLinearGradient(0, y + wave, w, y + wave + 6);
          grad.addColorStop(0, '#0891b2');
          grad.addColorStop(0.5, '#06b6d4');
          grad.addColorStop(1, '#0e7490');
          
          ctx.fillStyle = grad;
          // Overlay opacity to simulate interlocking weaves
          ctx.globalAlpha = 0.82;
          ctx.fillRect(0, y + wave, w, 6);
          ctx.globalAlpha = 1.0;
        }
        
        requestAnimationFrame(draw);
      }
      draw();
    }

    // 2. Count-Up Logic for KPI Stats on Landing Page
    function animateCountUp() {
      const counters = document.querySelectorAll('.counter-num');
      counters.forEach(counter => {
        const target = parseFloat(counter.getAttribute('data-target'));
        const isCurrency = counter.getAttribute('data-currency') === 'true';
        const isPercentage = counter.getAttribute('data-percentage') === 'true';
        const isPlus = counter.getAttribute('data-plus') === 'true';
        
        const duration = 1500; // 1.5 seconds
        const startValue = 0;
        const startTime = performance.now();
        
        function update(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease-out quadratic
          const ease = progress * (2 - progress);
          const current = target * ease;
          
          if (isCurrency) {
            counter.innerText = '₹' + Math.floor(current).toLocaleString('en-IN');
          } else if (isPercentage) {
            counter.innerText = current.toFixed(1) + '%';
          } else {
            counter.innerText = Math.floor(current).toLocaleString() + (isPlus ? '+' : '');
          }
          
          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            if (isCurrency) {
              counter.innerText = '₹' + target.toLocaleString('en-IN');
            } else if (isPercentage) {
              counter.innerText = target.toFixed(1) + '%';
            } else {
              counter.innerText = target.toLocaleString() + (isPlus ? '+' : '');
            }
          }
        }
        requestAnimationFrame(update);
      });
    }

    // Intersection observer to trigger count-up
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCountUp();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    const countersSec = document.getElementById('counters');
    if (countersSec) {
      observer.observe(countersSec);
    }
  });
</script>

