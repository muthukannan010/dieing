<%- include('partials/header') %>

<div class="erp-container">
  <%- include('partials/sidebar') %>
  
  <main class="erp-main">
    <header class="top-actions-bar">
      <button class="mobile-menu-toggle" onclick="document.getElementById('appSidebar').classList.add('sidebar-mobile-open')">
        <i class="fa-solid fa-bars"></i>
      </button>
      <div class="top-bar-title">
        <h1>Chemical Doser</h1>
        <p>Estimate recipe weights for alkali, salts, and neutralizing chemicals.</p>
      </div>
    </header>

    <div class="calculator-grid animate-fade">
      <div class="form-card">
        <h3 style="margin-bottom: 20px; font-family: 'Poppins', sans-serif; color: var(--dark-green);"><i class="fa-solid fa-flask"></i> Dosing parameters</h3>
        <form id="chemCalcForm">
          <div class="form-group">
            <label for="chem-weight">Total Load Weight (KG)</label>
            <input type="number" id="chem-weight" class="form-field" required min="1" placeholder="e.g. 800">
          </div>
          
          <div class="form-group">
            <label for="chem-type">Chemical Type</label>
            <select id="chem-type" class="form-field">
              <option value="Wetting Agent">Wetting Agent (Pretreatment swelling)</option>
              <option value="Salt">Salt (Exhausting electrolyte)</option>
              <option value="Soda Ash">Soda Ash (Alkali fixer)</option>
              <option value="Acetic Acid">Acetic Acid (Neutralizer wash)</option>
              <option value="Hydrogen Peroxide">Hydrogen Peroxide (Bleach)</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
            <i class="fa-solid fa-calculator"></i> Run Dosing Calculations
          </button>
        </form>
      </div>

      <div class="glass-card" id="chemResultPanel" style="opacity: 0.65;">
        <h3 style="margin-bottom: 20px; font-family: 'Poppins', sans-serif; color: var(--dark-green);"><i class="fa-solid fa-circle-info"></i> Chemical Recommendation</h3>
        
        <div class="result-item">
          <span>Required Quantity:</span>
          <span class="result-val" id="chem-res-qty">0.00 KG</span>
        </div>

        <div class="result-item">
          <span>Estimated Chemical Cost:</span>
          <span class="result-val" id="chem-res-cost" style="font-size: 1.4rem; color: var(--success);">$0.00</span>
        </div>

        <div style="margin-top: 25px; background-color: rgba(76, 175, 80, 0.05); padding: 15px; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
          <h5 style="color: var(--dark-green); margin-bottom: 5px;"><i class="fa-solid fa-triangle-exclamation"></i> Dosing instructions</h5>
          <p id="chem-res-instructions" style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5;">No calculations processed yet.</p>
        </div>
      </div>
    </div>

    <!-- AI Prediction Section -->
    <div class="calculator-grid animate-fade" style="margin-top: 20px;">
      <div class="form-card" style="grid-column: 1 / -1;">
        <h3 style="margin-bottom: 20px; font-family: 'Poppins', sans-serif; color: var(--dark-green);"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Color Recipe Prediction</h3>
        <p style="color: var(--text-secondary); margin-bottom: 15px;">Use historical machine learning data to predict dye and chemical requirements.</p>
        
        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
          <div class="form-group" style="flex: 1;">
            <label for="ai-fabric">Fabric Type</label>
            <input type="text" id="ai-fabric" class="form-field" placeholder="e.g. Cotton">
          </div>
          <div class="form-group" style="flex: 1;">
            <label for="ai-color">Target Color</label>
            <input type="text" id="ai-color" class="form-field" placeholder="e.g. Navy Blue">
          </div>
        </div>
        
        <button class="btn btn-secondary" onclick="predictColorRecipe()">
          <i class="fa-solid fa-brain"></i> Predict Recipe
        </button>
        
        <div id="ai-prediction-result" style="margin-top: 20px; padding: 15px; background-color: var(--bg-color); border-radius: var(--radius-sm); border: 1px solid var(--border-color); display: none;">
          <h4 style="color: var(--dark-green); margin-bottom: 10px;">Predicted Recipe</h4>
          <pre id="ai-prediction-content" style="background: #1e1e1e; color: #d4d4d4; padding: 15px; border-radius: 5px; font-family: monospace; overflow-x: auto;"></pre>
        </div>
      </div>
    </div>
  
  </main>
</div>

<script>
async function predictColorRecipe() {
  const fabricType = document.getElementById('ai-fabric').value;
  const colorName = document.getElementById('ai-color').value;
  
  if (!fabricType || !colorName) {
    alert("Please enter both Fabric Type and Target Color.");
    return;
  }
  
  const resultDiv = document.getElementById('ai-prediction-result');
  const resultContent = document.getElementById('ai-prediction-content');
  
  resultContent.innerText = "Analyzing historical data...\nGenerating prediction...";
  resultDiv.style.display = 'block';
  
  try {
    // Note: The flask app runs on port 3000 but Node.js might be on a different port. 
    // Assuming we can reach /api/predict-color directly if hosted together, or we'll proxy it.
    // For now we assume the Python API is accessible at http://localhost:3000/api/predict-color or same host.
    const response = await fetch('http://localhost:3000/api/predict-color', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ fabric_type: fabricType, color_name: colorName })
    });
    
    if (response.ok) {
      const data = await response.json();
      resultContent.innerText = JSON.stringify(data.recipe, null, 2);
    } else {
      resultContent.innerText = "Failed to connect to AI Engine.";
    }
  } catch (error) {
    console.error("AI Prediction Error:", error);
    resultContent.innerText = "Error: Could not reach the prediction service. Ensure the Flask engine is running on port 3000.";
  }
}
</script>

<%- include('partials/footer') %>
