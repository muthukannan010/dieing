<%- include('partials/header') %>

<div class="app-container">
  <%- include('partials/sidebar') %>
  
  <main class="app-main">
    <header class="page-header">
      <div class="page-title">
        <h1>Fabric Weight Calculator</h1>
        <p>Estimate fabric weight, processing fees, and raw pretreatment chemical recipes.</p>
      </div>
    </header>

    <div class="calculator-grid animate-fade">
      <!-- Calculator Inputs Panel -->
      <div class="calc-panel">
        <div class="calc-title">
          <i class="fa-solid fa-calculator"></i>
          <span>Fabric Parameters</span>
        </div>
        
        <form id="fabricCalcForm">
          <div class="form-group">
            <label for="gsm">GSM (Grams per Square Meter)</label>
            <input type="number" id="gsm" class="form-input" required min="10" max="800" placeholder="e.g. 180">
          </div>
          
          <div class="form-group">
            <label for="width">Fabric Width (Meters)</label>
            <input type="number" id="width" class="form-input" required min="0.1" max="10" step="0.01" placeholder="e.g. 1.8">
          </div>
          
          <div class="form-group">
            <label for="length">Fabric Length (Meters)</label>
            <input type="number" id="length" class="form-input" required min="1" max="100000" placeholder="e.g. 2500">
          </div>
          
          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
            <i class="fa-solid fa-calculator"></i> Run Calculations
          </button>
        </form>
      </div>

      <!-- Results Display Panel -->
      <div class="result-panel" id="fabricResultPanel" style="opacity: 0.7;">
        <div>
          <div class="calc-title">
            <i class="fa-solid fa-square-poll-horizontal"></i>
            <span>Results & Estimation</span>
          </div>
          
          <div class="result-item">
            <span>Calculated Weight:</span>
            <span class="result-val" id="res-weight">0.00 KG</span>
          </div>
          
          <div class="result-item">
            <span>Estimated Processing Cost (at $2.50/KG):</span>
            <span class="result-val" id="res-cost">$0.00</span>
          </div>
        </div>

        <div>
          <h4 style="margin: 20px 0 10px 0; font-family: 'Poppins', sans-serif;">Pretreatment Chemical Bath Requirements</h4>
          <div class="chem-req-grid">
            <div class="chem-req-card">
              <div class="chem-req-name">Wetting Agent (1%)</div>
              <div class="chem-req-val" id="req-wetting">0.00 KG</div>
            </div>
            <div class="chem-req-card">
              <div class="chem-req-name">Salt (15%)</div>
              <div class="chem-req-val" id="req-salt">0.00 KG</div>
            </div>
            <div class="chem-req-card">
              <div class="chem-req-name">Soda Ash (8%)</div>
              <div class="chem-req-val" id="req-soda">0.00 KG</div>
            </div>
            <div class="chem-req-card">
              <div class="chem-req-name">Acetic Acid (2%)</div>
              <div class="chem-req-val" id="req-acetic">0.00 KG</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>
