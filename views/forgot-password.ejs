<%- include('partials/header') %>

<div class="auth-wrapper">
  <a href="/" class="btn btn-secondary" style="position: absolute; top: 20px; left: 20px;"><i class="fa-solid fa-house"></i> Home</a>
  <div class="auth-box glass-card animate-fade">
    <div style="text-align: center; margin-bottom: 30px;">
      <i class="fa-solid fa-unlock-keyhole" style="font-size: 3rem; color: var(--primary); margin-bottom: 15px;"></i>
      <h2 style="font-family: 'Poppins', sans-serif; color: var(--dark-green);">Reset Password</h2>
      <p style="color: var(--text-secondary); font-size: 0.95rem;">Request a security recovery code key</p>
    </div>

    <form id="forgotPasswordForm">
      <div class="form-group">
        <label for="email">Corporate Email</label>
        <input type="email" id="email" name="email" class="form-field" required placeholder="name@company.com">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
        <i class="fa-solid fa-paper-plane"></i> Send Recovery Key
      </button>
    </form>

    <div style="text-align: center; margin-top: 25px; font-size: 0.9rem; color: var(--text-secondary);">
      Remembered? <a href="/login" style="color: var(--primary); font-weight: 700;">Back to Login</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
